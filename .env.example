# Build-time public URL; never put credentials here.
SITE_ORIGIN=https://your-domain.example
# Worker secrets go into `wrangler secret put`, or ignored .dev.vars locally.
# GITHUB_TOKEN: optional fine-grained token with public metadata read access only
# RESEND_API_KEY: optional email API key
# NOTIFY_FROM: verified sender, e.g. Portfolio <portfolio@your-domain.example>
