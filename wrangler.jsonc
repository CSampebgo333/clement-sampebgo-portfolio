{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"clement-sampebgo-portfolio",
 "main":"worker/index.mjs",
 "compatibility_date":"2026-10-01",
 "assets":{"directory":"./dist","binding":"ASSETS","run_worker_first":true,"not_found_handling":"404-page"},
 "d1_databases":[{"binding":"DB","database_name":"portfolio-review","database_id":"REPLACE_WITH_D1_DATABASE_ID","migrations_dir":"migrations"}],
 "r2_buckets":[{"binding":"BUCKET","bucket_name":"portfolio-media"}],
 "triggers":{"crons":["0 9 * * 1"]},
 "vars":{
  "GITHUB_USERNAME":"CSampebgo333",
  "SITE_ORIGIN":"https://REPLACE_WITH_YOUR_DOMAIN",
  "ACCESS_TEAM_DOMAIN":"REPLACE.cloudflareaccess.com",
  "ACCESS_AUD":"REPLACE_WITH_ACCESS_APPLICATION_AUD",
  "ADMIN_EMAIL":"cl.sampebgo@gmail.com",
  "EXCLUDED_REPOS":"CSampebgo333/clement-sampebgo-portfolio,CSampebgo333/Consumer-Insights-Data-Analytics-Externship,CSampebgo333/driving-test-platform"
 }
}
